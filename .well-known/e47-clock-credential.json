{
  "schema": "https://nicholaskouns-create.github.io/clock-credential/v1",
  "repository": "nicholaskouns-create/Time",
  "clock": {
    "repository": "nicholaskouns-create/Time",
    "mode": "NodeClock-simulated",
    "required_fields": [
      "clock_id",
      "tau",
      "coordinate_t",
      "phase_time",
      "observed_at_utc"
    ]
  },
  "credential": {
    "signature": "Ed25519",
    "digest": "SHA-256",
    "binding": [
      "repository",
      "commit",
      "run",
      "nonce",
      "observed_at_utc",
      "tau"
    ],
    "verification": "signature+trusted-issuer+expiry+durable-nonce-replay-check"
  },
  "status": "signed-receipt-library-committed; enforcement pending"
}
